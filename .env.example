# Configuration de l'API
API_HOST=127.0.0.1
API_PORT=8000

# MLflow
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT=entrainement_decrochage
MLFLOW_MODEL_NAME=dropout_classifier

# Règles de mise en service
MIN_F1_MACRO=0.45
MIN_RECALL_DROPOUT=0.60

# Stratégie de cache du modèle servi par l'API
MODEL_CACHE_TTL=300

# Chemins locaux
DATA_DIR=data
ARTIFACTS_DIR=artifacts

# Source de données
DATA_URL=https://archive.ics.uci.edu/static/public/697/predict+students+dropout+and+academic+success.zip

# Alertes: si vide, les alertes sont seulement écrites dans artifacts/alerts/
ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
